{
  "mapping": [
    {
      "oc": "/routing-policy/policy-definitions/policy-definition/statements/statement/actions/isis-actions",
      "srlinux": "/routing-policy/policy/statement/action/isis"
    },
    {
      "oc": "/routing-policy/policy-definitions/policy-definition/statements/statement/actions/isis-actions/{config,state}",
      "srlinux": ""
    },
    {
      "oc": "/routing-policy/policy-definitions/policy-definition/statements/statement/actions/isis-actions/{config,state}/set-level",
      "srlinux": "/routing-policy/policy/statement/action/isis/level"
    },
    {
      "oc": "/routing-policy/policy-definitions/policy-definition/statements/statement/actions/isis-actions/{config,state}/set-metric-type",
      "supported": false
    },
    {
      "oc": "/routing-policy/policy-definitions/policy-definition/statements/statement/actions/isis-actions/{config,state}/set-metric-style-type",
      "srlinux": "/routing-policy/policy/statement/action/isis/metric/set-style",
      "mapping": [
        {
          "WIDE_METRIC": "wide"
        }
      ],
      "deviations": {
        "add": {
          "must": [
            {
              "expression": "(.='WIDE_METRIC')",
              "error-message": "only WIDE_METRIC method is supported"
            }
          ]
        }
      }
    },
    {
      "oc": "/routing-policy/policy-definitions/policy-definition/statements/statement/actions/isis-actions/{config,state}/set-metric",
      "srlinux": "/routing-policy/policy/statement/action/isis/metric/set-value"
    },
    {
      "oc": "/routing-policy/policy-definitions/policy-definition/statements/statement/conditions/isis-conditions",
      "srlinux": "/routing-policy/policy/statement/match/isis"
    },
    {
      "oc": "/routing-policy/policy-definitions/policy-definition/statements/statement/conditions/isis-conditions/{config,state}",
      "srlinux": ""
    },
    {
      "oc": "/routing-policy/policy-definitions/policy-definition/statements/statement/conditions/isis-conditions/{config,state}/level-eq",
      "srlinux": "/routing-policy/policy/statement/match/isis/level"
    },
    {
      "oc": "/routing-policy/policy-definitions/policy-definition/statements/statement/conditions/isis-conditions/{config,state}/match-metric-type",
      "srlinux": "/routing-policy/policy/statement/match/isis/route-type",
      "mapping": [
        {
          "EXTERNAL": "external"
        },
        {
          "INTERNAL": "internal"
        }
      ]
    }
  ]
}
